# Xcode
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
*.xcworkspace/*
!*.xcworkspace/contents.xcworkspacedata
!*.xcworkspace/xcshareddata/
*.xcuserdata/
*.xcuserstate
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.build/
.swiftpm/

# CocoaPods
Pods/

# Temporary files
*.swp
*~.nib
*.tmp
*.temp
.DS_Store

# Backup files
*.backup
*.bak

# Scripts output（僅保留 symbols 建置產物供版控；其餘仍忽略）
scripts/output/*
!scripts/output/symbols_tw.json
!scripts/output/symbols_us.json
!scripts/output/symbols_crypto.json
!scripts/output/symbols_manifest.json

# Supabase secrets (never commit)
**/SupabaseConfig.secrets.swift
